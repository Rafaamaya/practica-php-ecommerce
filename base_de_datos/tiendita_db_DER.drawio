        <mxCell id="ejemplo_imagenes" parent="1" style="text;whiteSpace=wrap;html=1;verticalAlign=top;" value="&lt;div style=&quot;font-family:Helvetica;font-size:12px;&quot;&gt;&lt;b style=&quot;font-size:13px;&quot;&gt;Ejemplo de datos: imagenes (1 a N con productos)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#555;&quot;&gt;Cada producto tiene &lt;b&gt;muchas&lt;/b&gt; imágenes. Entre paréntesis, a qué producto apunta la FK.&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;table style=&quot;border-collapse:collapse;&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #d6b656;background:#fff2cc;padding:4px 8px;text-align:left;&quot;&gt;id (PK)&lt;/th&gt;&lt;th style=&quot;border:1px solid #d6b656;background:#fff2cc;padding:4px 8px;text-align:left;&quot;&gt;producto_id (FK)&lt;/th&gt;&lt;th style=&quot;border:1px solid #d6b656;background:#fff2cc;padding:4px 8px;text-align:left;&quot;&gt;ruta&lt;/th&gt;&lt;th style=&quot;border:1px solid #d6b656;background:#fff2cc;padding:4px 8px;text-align:left;&quot;&gt;alt&lt;/th&gt;&lt;th style=&quot;border:1px solid #d6b656;background:#fff2cc;padding:4px 8px;text-align:left;&quot;&gt;orden&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d6b656;padding:4px 8px;&quot;&gt;4&lt;/td&gt;&lt;td style=&quot;border:1px solid #d6b656;padding:4px 8px;&quot;&gt;2 &lt;span style=&quot;color:#888;&quot;&gt;(RoboCop)&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #d6b656;padding:4px 8px;&quot;&gt;robocop.jpg&lt;/td&gt;&lt;td style=&quot;border:1px solid #d6b656;padding:4px 8px;&quot;&gt;Figura de colección de RoboCop&lt;/td&gt;&lt;td style=&quot;border:1px solid #d6b656;padding:4px 8px;&quot;&gt;1&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d6b656;padding:4px 8px;&quot;&gt;5&lt;/td&gt;&lt;td style=&quot;border:1px solid #d6b656;padding:4px 8px;&quot;&gt;2 &lt;span style=&quot;color:#888;&quot;&gt;(RoboCop)&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #d6b656;padding:4px 8px;&quot;&gt;robocop-detalle-1.jpg&lt;/td&gt;&lt;td style=&quot;border:1px solid #d6b656;padding:4px 8px;&quot;&gt;Detalle de la figura de RoboCop&lt;/td&gt;&lt;td style=&quot;border:1px solid #d6b656;padding:4px 8px;&quot;&gt;2&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d6b656;padding:4px 8px;&quot;&gt;6&lt;/td&gt;&lt;td style=&quot;border:1px solid #d6b656;padding:4px 8px;&quot;&gt;2 &lt;span style=&quot;color:#888;&quot;&gt;(RoboCop)&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #d6b656;padding:4px 8px;&quot;&gt;robocop-detalle-2.jpg&lt;/td&gt;&lt;td style=&quot;border:1px solid #d6b656;padding:4px 8px;&quot;&gt;Figura de RoboCop vista completa&lt;/td&gt;&lt;td style=&quot;border:1px solid #d6b656;padding:4px 8px;&quot;&gt;3&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d6b656;padding:4px 8px;&quot;&gt;7&lt;/td&gt;&lt;td style=&quot;border:1px solid #d6b656;padding:4px 8px;&quot;&gt;3 &lt;span style=&quot;color:#888;&quot;&gt;(Espadachín)&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #d6b656;padding:4px 8px;&quot;&gt;espadachin-azul.jpg&lt;/td&gt;&lt;td style=&quot;border:1px solid #d6b656;padding:4px 8px;&quot;&gt;Figura de colección del Espadachín Sombrío&lt;/td&gt;&lt;td style=&quot;border:1px solid #d6b656;padding:4px 8px;&quot;&gt;1&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #d6b656;padding:4px 8px;&quot;&gt;8&lt;/td&gt;&lt;td style=&quot;border:1px solid #d6b656;padding:4px 8px;&quot;&gt;3 &lt;span style=&quot;color:#888;&quot;&gt;(Espadachín)&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #d6b656;padding:4px 8px;&quot;&gt;espadachin-azul-detalle-1.jpeg&lt;/td&gt;&lt;td style=&quot;border:1px solid #d6b656;padding:4px 8px;&quot;&gt;Detalle de la figura del Espadachín Sombrío&lt;/td&gt;&lt;td style=&quot;border:1px solid #d6b656;padding:4px 8px;&quot;&gt;2&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;br&gt;&lt;span style=&quot;color:#555;&quot;&gt;• &lt;b&gt;producto_id se repite&lt;/b&gt;: un producto → muchas imágenes (por eso es 1 a N).&lt;br&gt;• orden: 1 es la imagen principal (catálogo y foto grande del detalle); 2 y 3, las chicas. El orden vuelve a empezar en cada producto.&lt;br&gt;• UQ (producto_id + orden): un producto no puede tener dos imágenes con el mismo orden.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="270" width="720" x="530" y="590" as="geometry" />
        </mxCell>
