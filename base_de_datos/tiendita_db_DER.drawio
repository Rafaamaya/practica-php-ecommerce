        <mxCell id="ejemplo_productos" parent="1" style="text;whiteSpace=wrap;html=1;verticalAlign=top;" value="&lt;div style=&quot;font-family:Helvetica;font-size:12px;&quot;&gt;&lt;b style=&quot;font-size:13px;&quot;&gt;Ejemplo de datos: productos (catálogo + detalle)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#555;&quot;&gt;Cada producto es &lt;b&gt;una sola fila&lt;/b&gt; con los datos del catálogo y del detalle. (No se muestra descripcion para que entre. La imagen sale de imagenes con orden = 1.)&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;table style=&quot;border-collapse:collapse;&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #82b366;background:#d5e8d4;padding:4px 8px;text-align:left;&quot;&gt;id (PK)&lt;/th&gt;&lt;th style=&quot;border:1px solid #82b366;background:#d5e8d4;padding:4px 8px;text-align:left;&quot;&gt;nombre&lt;/th&gt;&lt;th style=&quot;border:1px solid #82b366;background:#d5e8d4;padding:4px 8px;text-align:left;&quot;&gt;precio&lt;/th&gt;&lt;th style=&quot;border:1px solid #82b366;background:#d5e8d4;padding:4px 8px;text-align:left;&quot;&gt;altura_cm&lt;/th&gt;&lt;th style=&quot;border:1px solid #82b366;background:#d5e8d4;padding:4px 8px;text-align:left;&quot;&gt;acabado&lt;/th&gt;&lt;th style=&quot;border:1px solid #82b366;background:#d5e8d4;padding:4px 8px;text-align:left;&quot;&gt;base_incluida&lt;/th&gt;&lt;th style=&quot;border:1px solid #82b366;background:#d5e8d4;padding:4px 8px;text-align:left;&quot;&gt;edicion&lt;/th&gt;&lt;th style=&quot;border:1px solid #82b366;background:#d5e8d4;padding:4px 8px;text-align:left;&quot;&gt;descripcion_extendida&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #82b366;padding:4px 8px;&quot;&gt;1&lt;/td&gt;&lt;td style=&quot;border:1px solid #82b366;padding:4px 8px;&quot;&gt;Raphael&lt;/td&gt;&lt;td style=&quot;border:1px solid #82b366;padding:4px 8px;&quot;&gt;574977.00&lt;/td&gt;&lt;td style=&quot;border:1px solid #82b366;padding:4px 8px;&quot;&gt;18.0&lt;/td&gt;&lt;td style=&quot;border:1px solid #82b366;padding:4px 8px;&quot;&gt;Pintura acrílica verde y roja pintada a mano&lt;/td&gt;&lt;td style=&quot;border:1px solid #82b366;padding:4px 8px;&quot;&gt;1&lt;/td&gt;&lt;td style=&quot;border:1px solid #82b366;padding:4px 8px;&quot;&gt;Edición limitada&lt;/td&gt;&lt;td style=&quot;border:1px solid #82b366;padding:4px 8px;&quot;&gt;Figura de Raphael inspirada en…&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #82b366;padding:4px 8px;&quot;&gt;2&lt;/td&gt;&lt;td style=&quot;border:1px solid #82b366;padding:4px 8px;&quot;&gt;RoboCop&lt;/td&gt;&lt;td style=&quot;border:1px solid #82b366;padding:4px 8px;&quot;&gt;735977.00&lt;/td&gt;&lt;td style=&quot;border:1px solid #82b366;padding:4px 8px;&quot;&gt;24.0&lt;/td&gt;&lt;td style=&quot;border:1px solid #82b366;padding:4px 8px;&quot;&gt;Pintura acrílica pintada a mano&lt;/td&gt;&lt;td style=&quot;border:1px solid #82b366;padding:4px 8px;&quot;&gt;1&lt;/td&gt;&lt;td style=&quot;border:1px solid #82b366;padding:4px 8px;&quot;&gt;Edición limitada&lt;/td&gt;&lt;td style=&quot;border:1px solid #82b366;padding:4px 8px;&quot;&gt;Réplica de RoboCop con una presencia…&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #82b366;padding:4px 8px;&quot;&gt;3&lt;/td&gt;&lt;td style=&quot;border:1px solid #82b366;padding:4px 8px;&quot;&gt;Espadachín Sombrío&lt;/td&gt;&lt;td style=&quot;border:1px solid #82b366;padding:4px 8px;&quot;&gt;528977.00&lt;/td&gt;&lt;td style=&quot;border:1px solid #82b366;padding:4px 8px;&quot;&gt;19.0&lt;/td&gt;&lt;td style=&quot;border:1px solid #82b366;padding:4px 8px;&quot;&gt;Pintura acrílica con detalles metalizados&lt;/td&gt;&lt;td style=&quot;border:1px solid #82b366;padding:4px 8px;&quot;&gt;0&lt;/td&gt;&lt;td style=&quot;border:1px solid #82b366;padding:4px 8px;&quot;&gt;Edición especial&lt;/td&gt;&lt;td style=&quot;border:1px solid #82b366;padding:4px 8px;&quot;&gt;El Espadachín Sombrío combina…&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;br&gt;&lt;sp