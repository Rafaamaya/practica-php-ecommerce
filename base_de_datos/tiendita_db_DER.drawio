        </mxCell>
        <mxCell id="r4" edge="1" parent="1" source="productos" target="pagos" style="edgeStyle=entityRelationEdgeStyle;endArrow=ERzeroToMany;startArrow=ERmandOne;endFill=0;startFill=0;html=1;fontSize=10;" value="">
          <mxGeometry relative="1" as="geometry" />
