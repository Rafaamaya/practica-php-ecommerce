        <mxCell id="ejemplo_etiquetas" parent="1" style="text;whiteSpace=wrap;html=1;verticalAlign=top;" value="&lt;div style=&quot;font-family:Helvetica;font-size:12px;&quot;&gt;&lt;b style=&quot;font-size:13px;&quot;&gt;Ejemplo de datos: producto_etiqueta (muchos a muchos)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#555;&quot;&gt;Cada fila une &lt;b&gt;un producto&lt;/b&gt; con &lt;b&gt;una etiqueta&lt;/b&gt;. Entre paréntesis, a qué registro apunta cada FK.&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;table style=&quot;border-collapse:collapse;&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #6c8ebf;background:#dae8fc;padding:4px 8px;text-align:left;&quot;&gt;id (PK)&lt;/th&gt;&lt;th style=&quot;border:1px solid #6c8ebf;background:#dae8fc;padding:4px 8px;text-align:left;&quot;&gt;producto_id (FK)&lt;/th&gt;&lt;th style=&quot;border:1px solid #6c8ebf;background:#dae8fc;padding:4px 8px;text-align:left;&quot;&gt;etiqueta_id (FK)&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #6c8ebf;padding:4px 8px;text-align:center;&quot;&gt;2&lt;/td&gt;&lt;td style=&quot;border:1px solid #6c8ebf;padding:4px 8px;&quot;&gt;2 &lt;span style=&quot;color:#888;&quot;&gt;(RoboCop)&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #6c8ebf;padding:4px 8px;&quot;&gt;1 &lt;span style=&quot;color:#888;&quot;&gt;(Nuevo)&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #6c8ebf;padding:4px 8px;text-align:center;&quot;&gt;3&lt;/td&gt;&lt;td style=&quot;border:1px solid #6c8ebf;padding:4px 8px;&quot;&gt;2 &lt;span style=&quot;color:#888;&quot;&gt;(RoboCop)&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #6c8ebf;padding:4px 8px;&quot;&gt;3 &lt;span style=&quot;color:#888;&quot;&gt;(Edición limitada)&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #6c8ebf;padding:4px 8px;text-align:center;&quot;&gt;6&lt;/td&gt;&lt;td style=&quot;border:1px solid #6c8ebf;padding:4px 8px;&quot;&gt;4 &lt;span style=&quot;color:#888;&quot;&gt;(Mazinger Z)&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #6c8ebf;padding:4px 8px;&quot;&gt;1 &lt;span style=&quot;color:#888;&quot;&gt;(Nuevo)&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #6c8ebf;padding:4px 8px;text-align:center;&quot;&gt;7&lt;/td&gt;&lt;td style=&quot;border:1px solid #6c8ebf;padding:4px 8px;&quot;&gt;4 &lt;span style=&quot;color:#888;&quot;&gt;(Mazinger Z)&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #6c8ebf;padding:4px 8px;&quot;&gt;5 &lt;span style=&quot;color:#888;&quot;&gt;(Envío gratis)&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #6c8ebf;padding:4px 8px;text-align:center;&quot;&gt;9&lt;/td&gt;&lt;td style=&quot;border:1px solid #6c8ebf;padding:4px 8px;&quot;&gt;6 &lt;span style=&quot;color:#888;&quot;&gt;(Maestro Roshi)&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #6c8ebf;padding:4px 8px;&quot;&gt;1 &lt;span style=&quot;color:#888;&quot;&gt;(Nuevo)&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;br&gt;&lt;span style=&quot;color:#555;&quot;&gt;• RoboCop aparece 2 veces: &lt;b&gt;un producto → muchas etiquetas&lt;/b&gt;.&lt;br&gt;• &quot;Nuevo&quot; aparece en RoboCop, Mazinger Z y Roshi: &lt;b&gt;una etiqueta → muchos productos&lt;/b&gt;.&lt;br&gt;• Orco no tiene filas: un producto puede no tener etiquetas.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="250" width="620" x="-480" y="300" as="geometry" />
        </mxCell>
