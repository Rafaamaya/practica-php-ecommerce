        <mxCell id="ejemplo_pagos" parent="1" style="text;whiteSpace=wrap;html=1;verticalAlign=top;" value="&lt;div style=&quot;font-family:Helvetica;font-size:12px;&quot;&gt;&lt;b style=&quot;font-size:13px;&quot;&gt;Ejemplo de datos: producto_pagos (muchos a muchos)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#555;&quot;&gt;Cada fila une &lt;b&gt;un producto&lt;/b&gt; con &lt;b&gt;una forma de pago&lt;/b&gt;. Entre paréntesis, a qué registro apunta cada FK.&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;table style=&quot;border-collapse:collapse;&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #b85450;background:#f8cecc;padding:4px 8px;text-align:left;&quot;&gt;id (PK)&lt;/th&gt;&lt;th style=&quot;border:1px solid #b85450;background:#f8cecc;padding:4px 8px;text-align:left;&quot;&gt;producto_id (FK)&lt;/th&gt;&lt;th style=&quot;border:1px solid #b85450;background:#f8cecc;padding:4px 8px;text-align:left;&quot;&gt;forma_pago_id (FK)&lt;/th&gt;&lt;th style=&quot;border:1px solid #b85450;background:#f8cecc;padding:4px 8px;text-align:left;&quot;&gt;descripcion&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #b85450;padding:4px 8px;text-align:center;&quot;&gt;4&lt;/td&gt;&lt;td style=&quot;border:1px solid #b85450;padding:4px 8px;&quot;&gt;2 &lt;span style=&quot;color:#888;&quot;&gt;(RoboCop)&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #b85450;padding:4px 8px;&quot;&gt;1 &lt;span style=&quot;color:#888;&quot;&gt;(Tarjeta)&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #b85450;padding:4px 8px;&quot;&gt;Aceptamos tarjetas de crédito y débito con pago seguro.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #b85450;padding:4px 8px;text-align:center;&quot;&gt;5&lt;/td&gt;&lt;td style=&quot;border:1px solid #b85450;padding:4px 8px;&quot;&gt;2 &lt;span style=&quot;color:#888;&quot;&gt;(RoboCop)&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #b85450;padding:4px 8px;&quot;&gt;2 &lt;span style=&quot;color:#888;&quot;&gt;(Cuotas)&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #b85450;padding:4px 8px;&quot;&gt;Hasta 3 cuotas sin interés según el banco.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #b85450;padding:4px 8px;text-align:center;&quot;&gt;6&lt;/td&gt;&lt;td style=&quot;border:1px solid #b85450;padding:4px 8px;&quot;&gt;2 &lt;span style=&quot;color:#888;&quot;&gt;(RoboCop)&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #b85450;padding:4px 8px;&quot;&gt;3 &lt;span style=&quot;color:#888;&quot;&gt;(Envío)&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #b85450;padding:4px 8px;&quot;&gt;Envío nacional con seguimiento o retiro en un punto acordado.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #b85450;padding:4px 8px;text-align:center;&quot;&gt;8&lt;/td&gt;&lt;td style=&quot;border:1px solid #b85450;padding:4px 8px;&quot;&gt;3 &lt;span style=&quot;color:#888;&quot;&gt;(Espadachín)&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #b85450;padding:4px 8px;&quot;&gt;2 &lt;span style=&quot;color:#888;&quot;&gt;(Cuotas)&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #b85450;padding:4px 8px;&quot;&gt;Disponible en hasta 3 cuotas sin interés.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;br&gt;&lt;span style=&quot;color:#555;&quot;&gt;• RoboCop aparece 3 veces: &lt;b&gt;un producto → muchas formas de pago&lt;/b&gt;.&lt;br&gt;• &quot;Cuotas&quot; aparece en RoboCop y Espadachín: &lt;b&gt;una forma de pago → muchos productos&lt;/b&gt;.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="230" width="680" x="530" y="300" as="geometry" />
        </mxCell>
